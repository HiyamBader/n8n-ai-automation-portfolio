        "message": "={{\n  '<div style=\"font-family:Arial,sans-serif;max-width:650px;color:#222\">' +\n    '<h2 style=\"color:#d93025\">🔥 New Hot Lead</h2>' +\n    '<p>A new high-priority lead requires immediate follow-up.</p>' +\n\n    '<table style=\"width:100%;border-collapse:collapse\">' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Name</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Calculate Lead Score').first().json.name + '</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Company</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Calculate Lead Score').first().json.company + '</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Email</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Calculate Lead Score').first().json.email + '</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Phone</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Calculate Lead Score').first().json.phone + '</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Budget</strong></td><td style=\"padding:8px;border:1px solid #ddd\">$' + $('Calculate Lead Score').first().json.budget + '</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Timeline</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Calculate Lead Score').first().json.timelineDays + ' days</td></tr>' +\n      '<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Lead Score</strong></td><td style=\"padding:8px;border:1px solid #ddd\"><strong>' + $('Calculate Lead Score').first().json.leadScore + '/100</strong></td></tr>' +\n    '</table>' +\n\n    '<h3>Requested Service</h3>' +\n    '<p>' + $('Calculate Lead Score').first().json.service + '</p>' +\n\n    '<h3>Summary</h3>' +\n    '<p>' + $('Calculate Lead Score').first().json.summary + '</p>' +\n\n    '<h3>Qualification Reasons</h3>' +\n    '<ul><li>' + ($('Calculate Lead Score').first().json.scoreReasons || []).join('</li><li>') + '</li></ul>' +\n  '</div>'\n}}",
