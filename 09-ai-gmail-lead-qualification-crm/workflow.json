    {
      "parameters": {
        "text": "={{\n  'Sender: ' + $('Normalize Email').first().json.sender +\n  '\\nSubject: ' + $('Normalize Email').first().json.subject +\n  '\\nMessage:\\n' + $('Normalize Email').first().json.message\n}}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"isLead\": true,\n  \"name\": \"Sarah Ahmed\",\n  \"email\": \"sarah@brightdental.example\",\n  \"phone\": \"+970599123456\",\n  \"company\": \"Bright Dental Clinic\",\n  \"service\": \"AI automation for lead qualification and appointment booking\",\n  \"budget\": 1500,\n  \"timelineDays\": 14,\n  \"summary\": \"Dental clinic needs a WhatsApp automation system to qualify leads and book appointments.\",\n  \"missingFields\": []\n}",
        "options": {
          "systemPromptTemplate": "Analyze the email and always return every field defined in the schema.\n\nIf the email is not a genuine sales or service inquiry:\n- Set isLead to false.\n- Set all unavailable text fields to an empty string.\n- Set budget and timelineDays to 0.\n- Add all unavailable lead fields to missingFields.\n- Provide a short summary explaining why the email is not a lead.\n\nIf the email is a lead:\n- Set isLead to true.\n- Extract only information explicitly stated in the email.\n- Do not invent values.\n- Use 0 for an unavailable budget or timelineDays.\n- Use an empty string for unavailable text fields.\n- List unavailable fields in missingFields.\n\nReturn only data matching the required schema."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        256,
        208
      ],
      "id": "124cff05-f4ab-4503-a1ad-049af24bdb24",
      "name": "Extract Lead Information",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        328,
        424
      ],
      "id": "a4a759a5-41bd-47fa-b526-c58d08d54267",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "const sourceEmail = $('Normalize Email').first().json;\n\nreturn $input.all().map(item => {\n  const lead = item.json.output ?? item.json;\n\n  const budget = Number(lead.budget) || 0;\n  const timelineDays = Number(lead.timelineDays) || 0;\n  const missingFields = Array.isArray(lead.missingFields)\n    ? lead.missingFields\n    : [];\n\n  let score = 0;\n  const scoreReasons = [];\n\n  if (!lead.isLead) {\n    return {\n      json: {\n        ...sourceEmail,\n        ...lead,\n        leadScore: 0,\n        leadStatus: 'Not a Lead',\n        scoreReasons: ['The email is not a sales inquiry']\n      }\n    };\n  }\n\n  if (budget >= 1000) {\n    score += 40;\n    scoreReasons.push('High budget');\n  } else if (budget >= 500) {\n    score += 30;\n    scoreReasons.push('Good budget');\n  } else if (budget >= 200) {\n    score += 20;\n    scoreReasons.push('Moderate budget');\n  } else if (budget > 0) {\n    score += 10;\n    scoreReasons.push('Budget provided');\n  }\n\n  if (timelineDays > 0 && timelineDays <= 14) {\n    score += 30;\n    scoreReasons.push('Ready to start soon');\n  } else if (timelineDays <= 30 && timelineDays > 0) {\n    score += 20;\n    scoreReasons.push('Short timeline');\n  } else if (timelineDays <= 90 && timelineDays > 0) {\n    score += 10;\n    scoreReasons.push('Timeline provided');\n  }\n\n  if (missingFields.length === 0) {\n    score += 20;\n    scoreReasons.push('Complete lead information');\n  } else if (missingFields.length <= 2) {\n    score += 10;\n    scoreReasons.push('Most information is available');\n  }\n\n  if (lead.company) {\n    score += 5;\n    scoreReasons.push('Company provided');\n  }\n\n  if (lead.email && lead.phone) {\n    score += 5;\n    scoreReasons.push('Complete contact details');\n  }\n\n  score = Math.min(score, 100);\n\n  const leadStatus =\n    score >= 70 ? 'Hot' :\n    score >= 40 ? 'Warm' :\n    'Cold';\n\n  return {\n    json: {\n      ...sourceEmail,\n      ...lead,\n      leadScore: score,\n      leadStatus,\n      scoreReasons\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        240
      ],
